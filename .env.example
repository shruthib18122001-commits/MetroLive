# --- Live arrivals (optional) -------------------------------------------------
# LA Metro's GTFS-realtime feed is served through Swiftly and requires an API
# key. Request one via the "Swiftly API Key Request Form" linked from
# https://developer.metro.net/api/  then paste it below.
#
# With no key set, /api/arrivals serves deterministic *demo* arrivals so the
# app is fully usable (responses carry `X-Data-Source: demo`).
SWIFTLY_API_KEY=

# Optional. Defaults to the LA Metro bus TripUpdates feed:
#   https://api.goswift.ly/real-time/lametro/gtfs-rt-trip-updates
# Rail feed:
#   https://api.goswift.ly/real-time/lametro-rail/gtfs-rt-trip-updates
METRO_TRIP_UPDATES_URL=

# Set to 0 to make /api/arrivals return 500 NOT_CONFIGURED instead of demo
# data when SWIFTLY_API_KEY is absent. Any other value (or unset) = demo on.
ARRIVALS_DEMO=
